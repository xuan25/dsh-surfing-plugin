{
  "name": "dsh-surfing-plugin",
  "version": "0.1.0",
  "description": "SearXNG search and Crawl4AI fetch providers for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "searxng",
    "crawl4ai",
    "web-search",
    "web-fetch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyijun/surfing-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/cyijun/surfing-plugin/issues"
  },
  "homepage": "https://github.com/cyijun/surfing-plugin#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && publint --pack npm",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
